# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ai_digital_manager?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth / JWT Secret Key
AUTH_SECRET=your_auth_secret_key_min_32_characters_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
